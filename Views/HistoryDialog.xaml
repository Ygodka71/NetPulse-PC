<UserControl x:Class="NetPulse.Views.HistoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="600">
    <Grid Background="#B0050810">
        <Border Background="#131B2B"
                BorderBrush="#24324D"
                BorderThickness="1"
                CornerRadius="20"
                MaxWidth="580"
                MaxHeight="620"
                Margin="20"
                Padding="22"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#2000E5FF">
                            <TextBlock Text="⏱" FontSize="16" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   Text="История проверок"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F1F5F9"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Clear All Button -->
                    <Button Grid.Column="1"
                            x:Name="ClearAllBtn"
                            Click="OnClearAllClick"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#F43F5E"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Margin="0,0,12,0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑 " FontSize="12"/>
                            <TextBlock x:Name="ClearAllLabel" Text="Очистить всё"/>
                        </StackPanel>
                    </Button>

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            Content="✕"
                            Click="OnCloseClick"
                            Width="30"
                            Height="30"
                            Background="#1C273D"
                            Foreground="#94A3B8"
                            BorderBrush="#24324D"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="15"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <Rectangle Grid.Row="1" Height="1" Fill="#24324D" Margin="0,14,0,14"/>

                <!-- Content Area -->
                <Grid Grid.Row="2">
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyStatePanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="📊" FontSize="42" HorizontalAlignment="Center" Foreground="#64748B"/>
                        <TextBlock x:Name="EmptyTitle"
                                   Text="История пока пуста"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"/>
                        <TextBlock x:Name="EmptyDesc"
                                   Text="Запустите тест скорости, чтобы сохранить результаты"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Records List -->
                    <ScrollViewer x:Name="ListScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RecordsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C273D"
                                            BorderBrush="#24324D"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top row: Date + Rating badge + Delete button -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding FormattedDate}"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Center"/>

                                                <Border Grid.Column="1"
                                                        Background="#2500E5FF"
                                                        CornerRadius="6"
                                                        Padding="8,2,8,2"
                                                        Margin="8,0,8,0">
                                                    <TextBlock Text="{Binding Record.RatingTitle}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#00E5FF"/>
                                                </Border>

                                                <Button Grid.Column="2"
                                                        Content="🗑"
                                                        Click="OnDeleteRecordClick"
                                                        Tag="{Binding Record}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#F43F5E"
                                                        FontSize="14"
                                                        Cursor="Hand"/>
                                            </Grid>

                                            <!-- Speeds Row -->
                                            <Grid Grid.Row="1" Margin="0,10,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="↓ Скачивание" FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock FontSize="18" FontWeight="Bold" FontFamily="Consolas, Roboto Mono" Foreground="#00E5FF">
                                                        <Run Text="{Binding Record.DownloadMbps, StringFormat='{}{0:F1}'}"/>
                                                        <Run Text=" Мбит/с" FontSize="11" Foreground="#94A3B8"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="↑ Отдача" FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock FontSize="18" FontWeight="Bold" FontFamily="Consolas, Roboto Mono" Foreground="#10B981">
                                                        <Run Text="{Binding Record.UploadMbps, StringFormat='{}{0:F1}'}"/>
                                                        <Run Text=" Мбит/с" FontSize="11" Foreground="#94A3B8"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Bottom Info Row -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock FontSize="11" Foreground="#64748B" VerticalAlignment="Center">
                                                    <Run Text="⚡ "/>
                                                    <Run Text="{Binding Record.PingMs}"/>
                                                    <Run Text=" мс  •  〰 "/>
                                                    <Run Text="{Binding Record.JitterMs}"/>
                                                    <Run Text=" мс"/>
                                                </TextBlock>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Record.ServerName}"
                                                           FontSize="11"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Footer Close Button -->
                <Button Grid.Row="3"
                        x:Name="CloseBtn"
                        Content="Закрыть"
                        Click="OnCloseClick"
                        Background="#1C273D"
                        Foreground="#F1F5F9"
                        FontWeight="Bold"
                        FontSize="13"
                        Height="38"
                        Margin="0,14,0,0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
