<UserControl x:Class="NetPulse.Views.HelpDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="600">
    <Grid Background="#B0050810">
        <Border Background="#131B2B"
                BorderBrush="#24324D"
                BorderThickness="1"
                CornerRadius="20"
                MaxWidth="560"
                Margin="20"
                Padding="22"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#2000E5FF">
                            <TextBlock Text="?" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DialogTitle"
                                   Text="Справка"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F1F5F9"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✕"
                            Click="OnCloseClick"
                            Width="30"
                            Height="30"
                            Background="#1C273D"
                            Foreground="#94A3B8"
                            BorderBrush="#24324D"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="15"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <Rectangle Height="1" Fill="#24324D" Margin="0,16,0,16"/>

                <!-- IP Inspection Card (If GeoIp) -->
                <Border x:Name="IpCard"
                        Background="#1C273D"
                        BorderBrush="#00E5FF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IpHeaderLabel"
                                       Text="ВАШ ПУБЛИЧНЫЙ IP-АДРЕС"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#00E5FF"/>
                            <Border Grid.Column="1"
                                    x:Name="IpBadge"
                                    Background="#2500E5FF"
                                    BorderBrush="#00E5FF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,2,6,2">
                                <TextBlock x:Name="IpBadgeText" Text="IPv4" FontSize="10" FontWeight="Bold" Foreground="#00E5FF"/>
                            </Border>
                        </Grid>

                        <TextBox x:Name="IpAddressText"
                                 Text="127.0.0.1"
                                 FontSize="17"
                                 FontWeight="Bold"
                                 FontFamily="Consolas, Roboto Mono"
                                 Foreground="#F1F5F9"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 Margin="0,8,0,8"/>

                        <Button x:Name="CopyIpBtn"
                                Click="OnCopyIpClick"
                                Background="#1A00E5FF"
                                Foreground="#00E5FF"
                                BorderBrush="#00E5FF"
                                BorderThickness="1"
                                Height="34"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="CopyIpIcon" Text="📋 " FontSize="12"/>
                                <TextBlock x:Name="CopyIpText" Text="Копировать IP" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Description -->
                <TextBlock x:Name="DescBlock"
                           Text="Описание"
                           FontSize="13"
                           Foreground="#CBD5E1"
                           LineHeight="19"
                           TextWrapping="Wrap"/>

                <!-- Impact -->
                <Border Background="#1C273D" CornerRadius="10" Padding="12" Margin="0,14,0,14">
                    <StackPanel>
                        <TextBlock x:Name="ImpactHeader" Text="Влияние на сеть" FontSize="12" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ImpactBlock" Text="Детали" FontSize="12" Foreground="#94A3B8" LineHeight="17" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Norms / Good Range -->
                <Border Background="#1C273D" CornerRadius="10" Padding="12" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock x:Name="NormHeader" Text="Нормальные значения" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4"/>
                        <TextBlock x:Name="GoodRangeBlock" Text="Нормы" FontSize="12" Foreground="#94A3B8" LineHeight="17" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Close Button -->
                <Button Content="Понятно"
                        Click="OnCloseClick"
                        Background="#00E5FF"
                        Foreground="#090D16"
                        FontWeight="Bold"
                        FontSize="14"
                        Height="42"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
