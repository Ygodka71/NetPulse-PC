<Window x:Class="NetPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NetPulse.Controls"
        xmlns:views="clr-namespace:NetPulse.Views"
        mc:Ignorable="d"
        Title="NetPulse — Умный тест скорости и сети"
        Height="860" Width="560"
        MinWidth="460" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border x:Name="WindowBorder"
            Background="#090D16"
            BorderBrush="#24324D"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <!-- Scaled UI and Modals Container -->
            <Grid x:Name="ScaledContentRoot" ClipToBounds="True">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="UiScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                </Grid.LayoutTransform>

                <!-- Main Content Layout -->
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Custom Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- 1: Header Bar -->
                    <RowDefinition Height="*"/>    <!-- 2: Scrollable Content Body -->
                    <RowDefinition Height="Auto"/> <!-- 3: Bottom Dock -->
                </Grid.RowDefinitions>

                <!-- 1. Custom Title Bar -->
                <Grid Grid.Row="0"
                      Height="38"
                      Background="#0F172A"
                      MouseDown="OnTitleBarMouseDown"
                      Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="⚡" FontSize="14" Foreground="#00E5FF" VerticalAlignment="Center"/>
                        <TextBlock Text="NetPulse"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="—"
                                ToolTip="Свернуть"
                                Click="OnMinimizeClick"
                                Width="44"
                                Height="38"
                                Background="Transparent"
                                Foreground="#94A3B8"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"/>
                        <Button x:Name="MaximizeBtn"
                                Content="□"
                                ToolTip="Развернуть"
                                Click="OnMaximizeClick"
                                Width="44"
                                Height="38"
                                Background="Transparent"
                                Foreground="#94A3B8"
                                BorderThickness="0"
                                FontSize="13"
                                Cursor="Hand"/>
                        <Button Content="✕"
                                ToolTip="Закрыть"
                                Click="OnCloseClick"
                                Width="44"
                                Height="38"
                                Background="Transparent"
                                Foreground="#94A3B8"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Header Bar: Logo + Status + Action Buttons -->
                <Grid Grid.Row="1" Margin="20,10,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title + Status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#1C273D" BorderBrush="#00E5FF" BorderThickness="1">
                            <TextBlock Text="⚡" FontSize="18" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NetPulse" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="StatusSubtext"
                                       Text="Сеть активна"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#10B981"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons: Pencil (Edit Mode), History, Settings -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Edit Mode Toggle -->
                        <Button x:Name="EditModeToggleBtn"
                                Click="OnToggleEditMode"
                                Width="36" Height="36"
                                Background="#1C273D"
                                BorderBrush="#24324D"
                                BorderThickness="1"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                ToolTip="Настройка показателей">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock x:Name="EditModeIcon" Text="✏" FontSize="14" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- History Button -->
                        <Button Click="OnOpenHistory"
                                Width="36" Height="36"
                                Background="#1C273D"
                                BorderBrush="#24324D"
                                BorderThickness="1"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                ToolTip="История проверок">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="⏱" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Settings Button -->
                        <Button Click="OnOpenSettings"
                                Width="36" Height="36"
                                Background="#1C273D"
                                BorderBrush="#24324D"
                                BorderThickness="1"
                                Cursor="Hand"
                                ToolTip="Настройки">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="⚙" FontSize="14" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 3. Scrollable Content Body -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,0,16,6">
                    <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
                        <!-- Telemetry Widgets Panel -->
                        <StackPanel x:Name="WidgetsPanel">
                            <controls:PulseWaveformControl x:Name="WaveformControl"/>

                            <Viewbox Height="200" HorizontalAlignment="Center" Margin="0,0,0,2">
                                <controls:SpeedGaugeControl x:Name="GaugeControl"/>
                            </Viewbox>

                            <TextBlock x:Name="PhaseStatusTextBlock"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Quality Grade Banner -->
                        <controls:QualityGradeBanner x:Name="GradeBannerControl"/>

                        <!-- Edit Mode Guidance Banner -->
                        <Border x:Name="EditModeBanner"
                                Background="#1A00E5FF"
                                BorderBrush="#4000E5FF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Margin="0,4,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="EditModeBannerTitle"
                                           Text="Настройка карточек на экране"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#00E5FF"/>
                                <TextBlock x:Name="EditModeBannerDesc"
                                           Text="Нажмите ✕ чтобы убрать показатель. Используйте стрелки для перемещения. Снизу можно вернуть скрытые показатели."
                                           FontSize="11.5"
                                           Foreground="#94A3B8"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric Cards Container (Responsive Grid) -->
                        <controls:MetricCardsContainer x:Name="CardsContainer"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. Bottom Dock Area -->
                <Grid Grid.Row="3" Background="#0C121E">
                    <!-- Normal Mode Buttons -->
                    <StackPanel x:Name="NormalModeDock" Margin="20,10,20,14" MaxWidth="1100" HorizontalAlignment="Stretch">
                        <Button x:Name="MainActionButton"
                                Click="OnMainActionClick"
                                Background="#00E5FF"
                                Foreground="#031A26"
                                FontWeight="Bold"
                                FontSize="14.5"
                                Height="48"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="14"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="MainActionIcon" Text="▶ " FontSize="14.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MainActionText" Text="Запустить тест скорости" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="PulseActionButton"
                                Click="OnTogglePulseAction"
                                Background="Transparent"
                                Foreground="#F1F5F9"
                                BorderBrush="#24324D"
                                BorderThickness="1"
                                FontSize="11.5"
                                Height="38"
                                Margin="0,6,0,0"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock x:Name="PulseActionText" Text="Живой пульс: Активен (Нажмите для паузы)"/>
                        </Button>
                    </StackPanel>

                    <!-- Edit Mode Bottom Dock -->
                    <Border x:Name="EditModeDock"
                            Background="#131B2B"
                            BorderBrush="#24324D"
                            BorderThickness="0,1,0,0"
                            CornerRadius="20,20,0,0"
                            Padding="16,12"
                            Visibility="Collapsed">
                        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="AddMetricsHeader"
                                       Text="ДОБАВИТЬ ПОКАЗАТЕЛИ"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#00E5FF"/>
                            <WrapPanel x:Name="HiddenChipsPanel" Margin="0,8,0,10"/>
                            <Button x:Name="DoneEditingBtn"
                                    Click="OnToggleEditMode"
                                    Content="Готово"
                                    Background="#00E5FF"
                                    Foreground="#031A26"
                                    FontWeight="Bold"
                                    FontSize="13.5"
                                    Height="40"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Modals and Overlays (Z-Index top) -->
            <views:HelpDialog x:Name="HelpOverlay" Visibility="Collapsed"/>
            <views:HistoryDialog x:Name="HistoryOverlay" Visibility="Collapsed"/>
            <views:SettingsDialog x:Name="SettingsOverlay" Visibility="Collapsed"/>
            <views:TestBreakdownDialog x:Name="BreakdownOverlay" Visibility="Collapsed"/>
        </Grid>

        <!-- Window Resizing Edges & Corners (Active in Normal state) -->
        <Grid x:Name="ResizeGrid">
                <!-- 4 Edges -->
                <Rectangle Tag="Left" Width="7" HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="SizeWE" Fill="Transparent" MouseDown="OnResizeMouseDown"/>
                <Rectangle Tag="Right" Width="7" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE" Fill="Transparent" MouseDown="OnResizeMouseDown"/>
                <Rectangle Tag="Top" Height="7" VerticalAlignment="Top" HorizontalAlignment="Stretch" Cursor="SizeNS" Fill="Transparent" MouseDown="OnResizeMouseDown"/>
                <Rectangle Tag="Bottom" Height="7" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Cursor="SizeNS" Fill="Transparent" MouseDown="OnResizeMouseDown"/>

                <!-- 4 Corners -->
                <Rectangle Tag="TopLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Fill="Transparent" MouseDown="OnResizeMouseDown"/>
                <Rectangle Tag="TopRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Fill="Transparent" MouseDown="OnResizeMouseDown"/>
                <Rectangle Tag="BottomLeft" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Fill="Transparent" MouseDown="OnResizeMouseDown"/>
                <Rectangle Tag="BottomRight" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Fill="Transparent" MouseDown="OnResizeMouseDown"/>
            </Grid>
        </Grid>
    </Border>
</Window>