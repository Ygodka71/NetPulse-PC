<UserControl x:Class="NetPulse.Controls.QualityGradeBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignWidth="500">
    <Border x:Name="BannerBorder"
            CornerRadius="12"
            BorderThickness="1"
            Padding="12,8"
            Margin="0,4,0,6"
            Cursor="Hand"
            MouseLeftButtonUp="OnBannerClick">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleBlock"
                           FontSize="13.5"
                           FontWeight="Bold"/>
                <TextBlock x:Name="SubtitleBlock"
                           FontSize="11"
                           Foreground="#94A3B8"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Border x:Name="ScoreCircle"
                        Width="36"
                        Height="36"
                        CornerRadius="18">
                    <TextBlock x:Name="ScoreBlock"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="›"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#94A3B8"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
