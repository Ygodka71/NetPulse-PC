<Application x:Class="NetPulse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NetPulse.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:QualityGradeToColorConverter x:Key="GradeToColor"/>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="DarkBackground" Color="#090D16"/>
        <SolidColorBrush x:Key="DarkSurface" Color="#131B2B"/>
        <SolidColorBrush x:Key="DarkSurfaceVariant" Color="#1C273D"/>
        <SolidColorBrush x:Key="DarkBorder" Color="#24324D"/>

        <SolidColorBrush x:Key="CyanAccent" Color="#00E5FF"/>
        <SolidColorBrush x:Key="CyanGlow" Color="#38BDF8"/>
        <SolidColorBrush x:Key="EmeraldSuccess" Color="#10B981"/>
        <SolidColorBrush x:Key="AmberWarning" Color="#F59E0B"/>
        <SolidColorBrush x:Key="RoseError" Color="#F43F5E"/>

        <SolidColorBrush x:Key="TextPrimaryDark" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondaryDark" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextTertiaryDark" Color="#64748B"/>

        <!-- Global Font -->
        <FontFamily x:Key="PrimaryFont">Segoe UI, Plus Jakarta Sans</FontFamily>
        <FontFamily x:Key="MonoFont">Consolas, Roboto Mono</FontFamily>

        <!-- Modern Cyberpunk/Glassmorphic CheckBox Style -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid x:Name="RootGrid" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckBorder"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="5"
                                    Background="#131B2B"
                                    BorderBrush="#2B3D5E"
                                    BorderThickness="1.5"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Path x:Name="CheckMark"
                                          Data="M 3.5 9 L 7 12.5 L 14.5 5"
                                          Stroke="#031A26"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover Unchecked -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1C273D"/>
                            </Trigger>

                            <!-- Checked State -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#00E5FF"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- Checked + Hover -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </MultiTrigger>

                            <!-- Pressed State -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CheckBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>

                            <!-- Disabled State -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Cyberpunk/Glassmorphic Slider Style -->
        <Style TargetType="{x:Type Slider}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <!-- Track Background -->
                            <Border Height="6"
                                    CornerRadius="3"
                                    Background="#131B2B"
                                    BorderBrush="#24324D"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid>
                                                    <Ellipse x:Name="ThumbGlow"
                                                             Width="18" Height="18"
                                                             Fill="#00E5FF"
                                                             Stroke="#090D16"
                                                             StrokeThickness="2.5"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbGlow" Property="Fill" Value="#38BDF8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbGlow" Property="Fill" Value="#E0F7FA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base ScrollViewer Style (Minimalist Dark) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#334155" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
